{
  "name": "@nerima-games/mc-render",
  "version": "0.2.2",
  "type": "module",
  "description": "Rendering and runtime input for the nerima-games Minecraft-clone rebuild: the post-processing chain, material policy, per-frame scratch buffers, and the InputService.",
  "homepage": "https://github.com/nerima-games/mc-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-render.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-render/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "rendering",
    "three"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "lint": "oxlint --deny-warnings src apps scripts test",
    "lint:fix": "oxlint --fix src apps scripts test",
    "preview": "tsx apps/preview-render/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.2.0",
    "@nerima-games/mc-meshing": "0.1.0",
    "@nerima-games/mc-sim": "0.1.23",
    "@nerima-games/mc-worldgen": "0.1.2",
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/vitest": "^0.25.1",
    "@types/node": "^22.19.11",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^0.12.0",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
