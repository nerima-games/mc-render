{
  "name": "@nerima-games/mc-render",
  "version": "0.2.14",
  "type": "module",
  "description": "Rendering and runtime input for the nerima-games Minecraft-clone rebuild: the post-processing chain, material policy, per-frame scratch buffers, and the InputService.",
  "homepage": "https://github.com/nerima-games/mc-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-render.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-render/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "rendering",
    "three"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json --pretty false && esbuild src/index.ts --bundle --format=esm --platform=node --target=es2024 --external:effect --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "lint": "oxlint --deny-warnings src apps scripts test",
    "lint:fix": "oxlint --fix src apps scripts test",
    "preview": "tsx apps/preview-render/main.ts",
    "benchmark": "tsx scripts/benchmark-chunk-updates.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "@nerima-games/mc-meshing": "0.1.4",
    "@nerima-games/mc-sim": "0.1.42",
    "@nerima-games/mc-worldgen": "0.1.14",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@effect/vitest": "^0.30.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "three": "^0.185.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
