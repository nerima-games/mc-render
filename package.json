{
  "name": "@nerima-games/mc-render",
  "version": "0.4.0",
  "type": "module",
  "description": "Rendering and runtime input for the nerima-games Minecraft-clone rebuild: the post-processing chain, material policy, per-frame scratch buffers, and the InputService.",
  "homepage": "https://github.com/nerima-games/mc-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-render.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-render/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "rendering",
    "three"
  ],
  "scripts": {
    "benchmark": "tsx scripts/benchmark-chunk-updates.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "build:web": "vite build",
    "dev:web": "vite",
    "lint": "oxlint --deny-warnings src apps scripts test && ast-grep scan",
    "lint:fix": "oxlint --fix src apps scripts test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "preview": "tsx apps/preview-render/main.ts",
    "preview:web": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false && tsc -p tsconfig.browser.json --pretty false",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "@nerima-games/mc-meshing": "0.1.5",
    "@nerima-games/mc-sim": "0.2.1",
    "@nerima-games/mc-worldgen": "0.2.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@types/node": "26.4.0",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.33.0",
    "three": "0.185.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
