{
  // Editor / language-server default project: everything in the repository.
  // CI gates use tsconfig.build.json (shipped source) and tsconfig.test.json
  // (tests + tooling); this file exists so that opening any file in an editor
  // resolves against the same options.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "vitest.config.ts"
  ],
  // `test/fixtures/**` names DOM types deliberately and is compiled by a test
  // against `lib.dom.d.ts` instead — see tsconfig.test.json.
  "exclude": ["node_modules", "coverage", "dist", "test/fixtures/**"]
}
