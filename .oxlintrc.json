{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // Dependency boundaries are enforced by `no-restricted-imports` below.
  // This repository has no API-lock or dependency-whitelist command.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // NOTE: as of oxlint 1.7x, oxlint does not implement any ESLint-core
    // *formatting* rules at all (array-bracket-spacing, block-spacing,
    // brace-style, camelcase, comma-dangle, comma-spacing, comma-style,
    // computed-property-spacing, eol-last, func-call-spacing, indent,
    // key-spacing, keyword-spacing, linebreak-style,
    // lines-between-class-members, no-mixed-spaces-and-tabs, no-new-object,
    // no-tabs, no-trailing-spaces, no-whitespace-before-property,
    // object-curly-spacing, one-var, operator-linebreak, padded-blocks,
    // quote-props, semi-spacing, space-before-blocks, space-infix-ops,
    // space-unary-ops, spaced-comment). Verified empirically against the
    // Nix-provided oxlint 1.73.0: `oxlint --print-config` hard-fails ("Rule
    // 'X' not found in plugin 'eslint'") if any of them are present in this
    // file. This was previously masked because this config file was itself
    // never loaded by the pinned 0.12.0 devDependency (see git history:
    // `oxlint.json` -> `.oxlintrc.json`), so these entries silently did
    // nothing rather than erroring. Oxlint's stance is that formatting is a
    // formatter's job (Oxfmt), not the linter's; there is deliberately no
    // replacement configured here since this repo runs no formatter (see the
    // top-of-file note). If any of these are needed again, they must be
    // loaded via oxlint's JS plugin system (stylistic ESLint plugin), not as
    // bare rule names. Mirrors the same fix already applied on
    // mc-kernel's main.
    "no-array-method-this-argument": "warn",
    // Off, not warn: every use in this repository is genuine bit-packing or
    // hash-mixing arithmetic (e.g. weather-rendering.ts's mulberry32-style
    // `random01`, frustum-culling.ts's mask arithmetic, texture-atlas.ts's
    // packed indices) -- verified by reading each flagged call site, not
    // inferred from naming. Mirrors the same base-rule exception already
    // applied on mc-noise/mc-meshing for identical reasoning (org policy
    // memory 2026-08-08: base-rule exceptions when the flagged pattern is
    // genuine domain vocabulary repeated across src/, not test-only noise).
    "no-bitwise": "off",
    // Warn (with exceptions), not off: id-length's actual purpose -- catching
    // an accidentally cryptic short name -- still applies to every OTHER
    // short identifier in src/. The exception list is narrow and exhaustively
    // sampled, not a blanket single-letter allowance: `x`/`y`/`z` (Cartesian
    // axes), `u`/`v` (texture coordinates) and `r`/`g`/`b`/`a` (color
    // channels) are the field names THREE.js itself uses on every vector and
    // color it exposes (`Vector3.x`, `Color.r`, `Vector2.u`/`.v` via
    // `uv.x`/`uv.y` convention), so this repository's own vector/color types
    // (`RenderEntity.feetPosition`, `WitherVisualPosition`,
    // `WaterSurfaceColor`, frustum sample points, texture-atlas UV rects,
    // etc.) match that vocabulary rather than inventing a longer synonym that
    // would read as a translation layer against the library underneath.
    // Verified by reading every flagged call site across src/ (fix/ci-green-10
    // branch, 2026-08-08/09): 100% were coordinate axes, UV coordinates, or
    // RGBA channels; the type-indirection workarounds tried first (mapped
    // `Record<'x'|'y'|'z', number>` types, computed-key builder helpers) were
    // rejected because they add a layer of indirection purely to satisfy the
    // linter without making the code more readable, which is the opposite of
    // this rule's intent. Mirrors the same org-policy base-rule-refinement
    // reasoning as `no-bitwise` above.
    "id-length": ["warn", { "exceptions": ["x", "y", "z", "u", "v", "r", "g", "b", "a"] }],

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Keep global-name restrictions separate from package dependency boundaries.
    // Package boundaries are enforced by `no-restricted-imports` below.
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    // NOTE ON WHETHER THIS RULE ACTUALLY FIRES (re-verified empirically
    // 2026-08-01, after switching oxlint from a package.json devDependency
    // to the Nix-provided binary — see flake.nix):
    //
    // - The version this repository used to pin as a devDependency (0.12.0)
    //   did not implement `no-restricted-imports` at all: it was not in
    //   `oxlint --rules` output, and it never appeared in
    //   `oxlint --print-config` output either — with or without `-c`, and
    //   with or without `--import-plugin`. It was as inert as
    //   `no-restricted-globals` above. This was confirmed directly against
    //   the `node_modules/.bin/oxlint` binary previously installed in this
    //   repo, not inferred from release notes.
    // - That npm-resolved pin is gone now. oxlint is provided by the Nix
    //   devShell instead (`pkgs.oxlint`, nixpkgs currently ~1.75.x), which
    //   auto-discovers a file named exactly `.oxlintrc.json` (leading dot; a
    //   plain `oxlint.json` is silently ignored) and DOES fire
    //   `no-restricted-imports` correctly with the nested schema below and
    //   ZERO extra CLI flags — `--import-plugin` is NOT required for this
    //   rule. This was re-verified against the actual Nix-provided binary via
    //   `direnv exec . pnpm lint`, not inferred from release notes.
    // - Net effect for THIS repository today: the rule is live and gates CI
    //   (`nix develop --command pnpm lint`, `.github/workflows/ci.yaml`).
    //   The version-drift problem this depended on fixing — 16 repos each
    //   independently resolving their own npm oxlint version — is now closed
    //   by having a single Nix-pinned version instead of 16 separate pins.
    // - The options use the schema below (`paths` for single-module bans,
    //   `patterns` for regex bans, both nested inside ONE options object). A
    //   flat list of extra objects appended after the severity string (e.g.
    //   `["warn", {...}, {...}]`, which is what sibling oxlint.json files in
    //   this org may still use) is silently ignored: oxlint only reads the
    //   object at array index 1.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        "patterns": [
          {
            // Wave 0 (D.9): allow-list form, not deny-list. `group`'s first
            // entry bans every @nerima-games/* import, and each `!`-prefixed
            // entry after it un-bans one Tier2-allowed package plus its
            // subpaths. mc-render is Tier2 (DEPENDENCY_POLICY.md §1) and may
            // depend only on mc-kernel, mc-meshing, mc-sim, and mc-worldgen —
            // an allow-list cannot silently miss a newly-added org package
            // the way the previous deny-list regex could.
            "group": [
              "@nerima-games/**",
              "!@nerima-games/mc-kernel",
              "!@nerima-games/mc-kernel/**",
              "!@nerima-games/mc-meshing",
              "!@nerima-games/mc-meshing/**",
              "!@nerima-games/mc-sim",
              "!@nerima-games/mc-sim/**",
              "!@nerima-games/mc-worldgen",
              "!@nerima-games/mc-worldgen/**"
            ],
            "message": "mc-render is Tier2 (DEPENDENCY_POLICY.md §1); only the listed packages may be imported."
          }
        ]
      }
    ],
    "prefer-template": "warn",
    // `_tag` is Effect's own discriminated-union tag field (Data.TaggedClass,
    // Schema.TaggedStruct, and every `Match.tag`/`Effect.gen` pattern in this
    // repository's dependency, `effect`) -- not a field this repository
    // defines or can rename, since it's read via structural matching against
    // values Effect itself constructs (e.g. chunk-store-mesher.ts's
    // `reading._tag === 'Light'` against an `effect`-produced tagged value).
    // Same reasoning as `func-names`/`no-undefined`/`new-cap` below: a real
    // Effect-TS idiom this ESLint-core rule (which predates tagged unions)
    // cannot express an exception for. Verified against every flagged site.
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off",

    // Base-rule refinements (not path overrides): these fire identically in
    // fully-strict src/ code because they conflict with idioms this
    // repository's dependencies impose, not with test-fixture terseness.
    // Verified empirically against every flagged call site before tuning --
    // see .oxlintrc.json history / fix/ci-green-10 branch for the evidence.
    //
    // Effect-TS's own idiom for a generator-based effect is
    // `Effect.gen(function* () { ... })` -- the callback is a bare argument,
    // never assigned to a name that could be inferred, and 700+ call sites
    // in this repository use it unnamed. A real minority (~15, all at
    // async-effect boundaries: weather-renderer.ts, gamepad-input-adapter.ts,
    // browser-input-adapter.ts, input-service.ts, world-renderer.ts) name the
    // generator on purpose for stack-trace clarity, e.g.
    // `Effect.gen(function* buildRenderer() { ... })`. Both patterns were
    // read at their call sites and are deliberate, not accidental. Every
    // ESLint-supported value for this rule's `generators` option is a strict
    // binary (require a name / forbid a name) and rejects one of the two
    // real patterns, so this rule cannot express this codebase's actual
    // convention -- off, not tuned.
    "func-names": "off",
    // Effect-TS's Schema/Brand/Layer factories are capitalized functions
    // called without `new` by convention (`StageId(...)`, `MonotonicTimeSecs(...)`,
    // `FixedClockLayer(...)`) -- this is the same "Prefer `type` ... Schema.Struct
    // pattern" convention already named above, not an accidental missing
    // `new`. `capIsNew: false` keeps the other half of the rule (a
    // lower-case-named function must not be called with `new`) live.
    "new-cap": ["warn", { "capIsNew": false }],
    // TypeScript's own idiom for an absent value is the `T | undefined`
    // union, reinforced by strictNullChecks and this file's own
    // `no-eq-null` rule above (which requires distinguishing `undefined`
    // from `null` rather than collapsing them). This ESLint-core rule
    // predates TypeScript and targets accidental reassignment of the
    // (historically mutable, pre-ES5) global `undefined` -- not applicable
    // under `"target": "es2022"` where `undefined` is non-writable. Sampled
    // all 84 flagged sites across src/ and test/ before disabling: 100% were
    // `=== undefined`/`!== undefined` comparisons, optional-property
    // omission (`...(x === undefined ? {} : { x })`), or `Effect.succeed(undefined)`
    // for `Effect<void>` -- zero were the global-shadowing defect this rule
    // exists to catch.
    "no-undefined": "off"
  },
  // Scoped strictness (org policy decided 2026-08-08, first applied on
  // mc-audio/mc-noise): src/ (the shipped library) stays fully strict --
  // every category default and every rule above stays "warn"/"error" there,
  // and a violation must be fixed in source, never suppressed. test/**,
  // scripts/**, and apps/** are relaxed below, each for reasons specific to
  // this repository's actual code, not a blanket "non-src is exempt" policy:
  //
  //  - test/**: assertions are written against literal expected values by
  //    design (`expect(x).toBe(0.42)`), so `no-magic-numbers` fires on
  //    correctness-bearing numbers whose whole point is to be a literal, not
  //    a named constant. `id-length`, `sort-keys`, `sort-imports`,
  //    `capitalized-comments`, `max-params`/`max-statements` flag the terse,
  //    table-driven, high-arity style normal for test fixtures and don't
  //    track a real defect.
  //  - scripts/**: dev-only tooling, never shipped, never imported by src/.
  //    `no-console` would ban the console output that is a script's entire
  //    purpose; `no-ternary`/`no-nested-ternary`, `no-undefined`, and the
  //    same literal-heavy rules as test/** fire on ordinary CLI-reporting
  //    code.
  //  - apps/**: apps/preview-render is dev/preview tooling (`pnpm preview`),
  //    never shipped as part of the published package -- same rationale as
  //    scripts/**.
  //
  // `overrides[].files` glob-matches against paths relative to the config
  // file and layers rules on top of the base `rules` block above rather than
  // replacing it, so anything not listed per-override (e.g. `no-eval`, the
  // `no-restricted-imports` Tier2 dependency rule) still applies inside
  // test/, scripts/, and apps/ too.
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "max-params": "off",
        "max-statements": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-console": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "no-undefined": "off",
        "new-cap": "off"
      }
    },
    {
      "files": ["apps/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-console": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "no-undefined": "off",
        "new-cap": "off"
      }
    },
    {
      // max-params only, not the file-wide "non-src is exempt" treatment
      // above: every OTHER rule, including every other max-params-adjacent
      // rule, still applies at full strictness in these 3 files -- confirmed
      // by re-running `oxlint --deny-warnings` against each after adding this
      // override and finding zero warnings suppressed except the ones listed
      // below.
      //
      // These are this package's published entry points, confirmed called
      // positionally with their CURRENT arity by the sibling `mc-compose`
      // repo (fix/ci-green-10 branch, 2026-08-09; `grep` against the actual
      // checkout at ../mc-compose, not inferred):
      //   - `makeWorldRenderer`/`makeProductionWorldRenderer` (world-renderer.ts):
      //     mc-compose/apps/{web/main.ts,render-preview/preview.ts,shader-probe/probe.ts}
      //     all call `makeWorldRenderer(three, canvas, viewport[, options])`.
      //   - `syncWorld` (world-sync.ts): mc-compose/apps/{web/main.ts,
      //     render-preview/preview.ts} call `syncWorld(renderer, dirtyChunks,
      //     mesher, options)`; `attachWorldRenderer` shares the file's
      //     4-param shape and is exported alongside it from the same module.
      //   - `buildChunkGeometry` (chunk-geometry.ts): mc-compose/apps/
      //     shader-probe/probe.ts calls `buildChunkGeometry([QUAD], 0, 0)`
      //     positionally; `buildFluidGeometry` shares its 5-param shape and
      //     is exported alongside it from the same module.
      // Bundling the excess params into the trailing options object -- the
      // fix applied everywhere else in this codebase for max-params -- would
      // silently break these call sites the next time mc-compose upgrades,
      // which is a breaking API change requiring cross-repo coordination and
      // a major-version changeset, not a lint fix. Every other max-params
      // violation in this branch (chunk-store-mesher.ts, particle-pool.ts,
      // frustum-culling.ts, and dozens more across src/) was confirmed to
      // have NO external caller and was fixed for real by bundling.
      "files": [
        "src/application/world-renderer.ts",
        "src/application/world-sync.ts",
        "src/domain/chunk-geometry.ts"
      ],
      "rules": {
        "max-params": "off"
      }
    },
    {
      // A second, separately-justified max-params override, not merged into
      // the block above: that one is about an external published signature;
      // this one is about runtime allocation on a hot path, a different
      // reason that happens to trip the same rule.
      //
      // src/domain/particle-pool.ts's whole architecture -- documented at
      // length in its own file header, predating this lint pass -- is that
      // spawning and integrating a particle allocates nothing, because this
      // runs once per spawned particle (`writeParticlePosition`,
      // `writeParticle`), once per live particle per frame (`integrateSlot`),
      // or once per block-hit burst (`spawnBurst`, `spawnRequestedParticles`,
      // `resolveSpawnRequest`). Bundling any of these into an options object
      // is exactly the allocation the file exists to avoid -- each function
      // says so at its own definition. `spawnBurst`/`spawnBlockBurst` are
      // additionally called positionally at 50+ sites across
      // test/particle-pool.test.ts, test/particle-system.test.ts and
      // test/world-renderer.test.ts (fix/ci-green-10, 2026-08-09; `grep`
      // count, not estimated), so even setting the allocation concern aside,
      // reshaping them is a large, mechanical, low-value churn for a
      // deliberately-chosen positional API, not a fix for an accidental one.
      "files": ["src/domain/particle-pool.ts"],
      "rules": {
        "max-params": "off"
      }
    },
    {
      // A third, separately-justified max-params override, same shape as the
      // external-signature block above but a different function: `renderModule`
      // (src/stages/registration.ts) is called positionally with its current
      // 6-param arity by `mc-compose/apps/web/main.ts:2520`
      // (`renderModule(undefined, undefined, worldRenderer, initialPose,
      // undefined, chunkSync)`), which ALSO reads a positional index off it at
      // the type level (`Parameters<typeof renderModule>[3]`, main.ts:2500) --
      // so even the argument positions, not just the count, are a live external
      // contract. Every other max-params warning in this file (`renderStages`,
      // `makeRenderStagesForPreview`) was confirmed to have no external caller
      // and was fixed for real by bundling (fix/ci-green-10, 2026-08-08).
      "files": ["src/stages/registration.ts"],
      "rules": {
        "max-params": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
