{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2024 only, deliberately. The core, test and terminal-preview projects
    // remain DOM-free; the explicit browser/package projects opt into DOM for
    // `src/browser.ts` only. This keeps the pointer-lock state machine and all
    // pure modules testable under `environment: 'node'` while still shipping a
    // real WebGL boundary for browser consumers.
    // Turning the flag on for the whole project to serve one adapter would have
    // removed that mechanism from every pure file at the same time, and nothing
    // would have noticed for months.
    //
    // A real `Window` / `Document` / `HTMLCanvasElement` satisfying those
    // structural types is proved, not assumed: `test/fixtures/dom-surface.ts` is
    // compiled against the real `lib.dom.d.ts` by
    // `test/browser-input-adapter.test.ts`.
    //
    // `application/dom-surface.ts` and `application/three-surface.ts` keep the
    // core contracts narrow. `tsconfig.browser.json` and
    // `tsconfig.package.json` are the only projects that compile the concrete
    // browser entry with DOM and the real Three declarations.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // Source-oriented configs remain check-only; the package build emits the
    // public artifacts through tsdown.
    "noEmit": true

  }
}
