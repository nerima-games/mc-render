{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2024 only, deliberately — AND THE `window` INPUT ADAPTER DID NOT CHANGE
    // THAT.
    //
    // mc-render is the one repository that legitimately needs the DOM: THREE.js,
    // WebGL, `window` event registration, pointer lock. It now HAS the `window`
    // event registration (`application/browser-input-adapter.ts`) and `"DOM"` is
    // still absent, because the adapter describes the ~8 DOM members it actually
    // uses as structural types in `application/dom-surface.ts` rather than
    // importing a 20,000-line lib. Read that file's header for the argument; the
    // short version is that `lib: ["ES2024"]` + `types: []` on THIS project is
    // the mechanism that keeps the pointer-lock state machine testable under
    // `environment: 'node'`, and plan.md §3.10 says no browser test could
    // replace it (Playwright is on SwiftShader and cannot do pointer lock).
    // Turning the flag on for the whole project to serve one adapter would have
    // removed that mechanism from every pure file at the same time, and nothing
    // would have noticed for months.
    //
    // A real `Window` / `Document` / `HTMLCanvasElement` satisfying those
    // structural types is proved, not assumed: `test/fixtures/dom-surface.ts` is
    // compiled against the real `lib.dom.d.ts` by
    // `test/browser-input-adapter.test.ts`.
    //
    // The THREE.js adapter and the worker pool are where `"DOM"` /
    // `"WebWorker"` get argued about again — a class hierarchy the size of
    // THREE's is not a handful of members. See docs/design-notes.md.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // Check-only by default. The package build overrides this in
    // `tsconfig.build.json` to emit declarations alongside the esbuild bundle.
    "noEmit": true

  }
}
